# ── OpenAI ────────────────────────────────────────────
OPENAI_API_KEY=                                        # REQUIRED — needed to run the AI website builder
OPENAI_MODEL=gpt-4.1-mini                              # OPTIONAL — defaults to gpt-4.1-mini

# ── AWS S3 Hosting (optional – leave blank to save locally) ────────────────
AWS_ACCESS_KEY_ID=                                     # OPTIONAL — required only for S3 deployment
AWS_SECRET_ACCESS_KEY=                                 # OPTIONAL — required only for S3 deployment
AWS_REGION=us-east-1                                   # OPTIONAL — defaults to us-east-1
S3_BUCKET_NAME=                                        # OPTIONAL — required only for S3 deployment

# ── Snowflake (optional – leave blank to use SQLite fallback) ──────────────
SNOWFLAKE_ACCOUNT=                                     # OPTIONAL — leave blank to use SQLite
SNOWFLAKE_USER=                                        # OPTIONAL — leave blank to use SQLite
SNOWFLAKE_PASSWORD=                                    # OPTIONAL — leave blank to use SQLite
SNOWFLAKE_DATABASE=WEBSITE_BUILDER                     # OPTIONAL — defaults to WEBSITE_BUILDER
SNOWFLAKE_SCHEMA=PUBLIC                                # OPTIONAL — defaults to PUBLIC
SNOWFLAKE_WAREHOUSE=COMPUTE_WH                         # OPTIONAL — defaults to COMPUTE_WH
SNOWFLAKE_ROLE=SYSADMIN                                # OPTIONAL — defaults to SYSADMIN

# ── Auth / JWT ────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-secret-before-production  # REQUIRED — must be changed before production
JWT_TTL_MINUTES=1440                                   # OPTIONAL — session duration in minutes, defaults to 1440

# ── Stripe (platform billing – optional) ─────────────
STRIPE_SECRET_KEY=                                     # OPTIONAL — required only for paid plan billing
STRIPE_WEBHOOK_SECRET=                                 # OPTIONAL — required only for Stripe webhooks
STRIPE_PRO_PRICE_ID=                                   # OPTIONAL — required only for Pro plan
STRIPE_ENTERPRISE_PRICE_ID=                            # OPTIONAL — required only for Enterprise plan

# ── OTP – Email (SMTP / SendGrid) ─────────────────────
SMTP_HOST=smtp.sendgrid.net                            # OPTIONAL — required for email OTP / notifications
SMTP_PORT=587                                          # OPTIONAL — defaults to 587
SMTP_USER=apikey                                       # OPTIONAL — required for email OTP / notifications
SMTP_PASSWORD=                                         # OPTIONAL — required for email OTP / notifications
SMTP_FROM=noreply@websitebuilder.ai                    # OPTIONAL — sender address for outgoing emails

# ── OTP – SMS (Twilio – optional) ────────────────────
TWILIO_ACCOUNT_SID=                                    # OPTIONAL — required for SMS OTP
TWILIO_AUTH_TOKEN=                                     # OPTIONAL — required for SMS OTP
TWILIO_FROM_NUMBER=                                    # OPTIONAL — required for SMS OTP

# ── Twilio WhatsApp ───────────────────────────────────────────────────────────
# Sandbox: whatsapp:+14155238886   Production: your Twilio WhatsApp-enabled number
TWILIO_WHATSAPP_FROM=                                  # OPTIONAL — required for WhatsApp notifications

# ── CORS ──────────────────────────────────────────────
# Comma-separated allowed origins. Leave blank = localhost only.
# Example: https://app.yourdomain.com,https://admin.yourdomain.com
CORS_ORIGINS=                                          # OPTIONAL — leave blank for localhost-only dev mode

# ── Web Search (Tavily – optional, improves content) ──
TAVILY_API_KEY=                                        # OPTIONAL — enables live web search context in builds

# ── Social Search (RapidAPI Twitter – optional) ───────
RAPIDAPI_KEY=                                          # OPTIONAL — enables social search context in builds

# ── App ───────────────────────────────────────────────
OUTPUT_DIR=output                                      # OPTIONAL — directory for generated website files
SQLITE_DB_PATH=data/website_builder.db                 # OPTIONAL — SQLite database path (when Snowflake is not used)
WEBSITE_DOMAIN=                                        # OPTIONAL — public domain for deployed websites
VERBOSE_MODE=true                                      # OPTIONAL — enables verbose CrewAI logging

# ── Monitoring ────────────────────────────────────────────────────────────────
MONITOR_INTERVAL_MINUTES=5                             # OPTIONAL — uptime check interval in minutes
MONITOR_TIMEOUT_SEC=10                                 # OPTIONAL — uptime check HTTP timeout in seconds
# Public URL of this platform (used by monitoring checks that call the API externally)
PLATFORM_API_URL=http://localhost:8000                 # OPTIONAL — set to your public URL in production

# ── Admin Superuser (created on first run) ────────────────────────────────────
ADMIN_EMAIL=admin@websitebuilder.ai                    # REQUIRED — superuser email (change before production)
ADMIN_PASSWORD=<change-to-a-strong-password>           # REQUIRED — must be changed; never use a guessable default
ADMIN_NAME=Super Admin                                 # OPTIONAL — display name for the superuser account

# ── Secret Store Encryption Key ───────────────────────────────────────────────
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
STORAGE_SECRETS_KEY=                                   # OPTIONAL — required to encrypt/decrypt per-website credentials

