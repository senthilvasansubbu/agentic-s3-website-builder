# ── OpenAI ────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# ── AWS S3 Hosting (optional – leave blank to save locally) ────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=

# ── Snowflake (optional – leave blank to use SQLite fallback) ──────────────
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_DATABASE=WEBSITE_BUILDER
SNOWFLAKE_SCHEMA=PUBLIC
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_ROLE=SYSADMIN

# ── Auth / JWT ────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-secret-before-production
JWT_TTL_MINUTES=1440

# ── Stripe (platform billing – optional) ─────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_ENTERPRISE_PRICE_ID=

# ── OTP – Email (SMTP / SendGrid) ─────────────────────
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=
SMTP_FROM=noreply@websitebuilder.ai

# ── OTP – SMS (Twilio – optional) ────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ── Twilio WhatsApp ───────────────────────────────────────────────────────────
# Sandbox: whatsapp:+14155238886   Production: your Twilio WhatsApp-enabled number
TWILIO_WHATSAPP_FROM=

# ── CORS ──────────────────────────────────────────────
# Comma-separated allowed origins. Leave blank = localhost only.
# Example: https://app.yourdomain.com,https://admin.yourdomain.com
CORS_ORIGINS=

# ── Web Search (Tavily – optional, improves content) ──
TAVILY_API_KEY=

# ── Social Search (RapidAPI Twitter – optional) ───────
RAPIDAPI_KEY=

# ── App ───────────────────────────────────────────────
OUTPUT_DIR=output
SQLITE_DB_PATH=data/website_builder.db
WEBSITE_DOMAIN=
VERBOSE_MODE=true

# ── Monitoring ────────────────────────────────────────────────────────────────
MONITOR_INTERVAL_MINUTES=5
MONITOR_TIMEOUT_SEC=10
# Public URL of this platform (used by monitoring checks that call the API externally)
PLATFORM_API_URL=http://localhost:8000

# ── Admin Superuser (created on first run) ────────────────────────────────────
ADMIN_EMAIL=admin@websitebuilder.ai
ADMIN_PASSWORD=Admin@1234
ADMIN_NAME=Super Admin

# ── Secret Store Encryption Key ───────────────────────────────────────────────
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
STORAGE_SECRETS_KEY=

