# ── OpenAI ────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4

# ── AWS S3 Hosting ────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=

# ── Snowflake ─────────────────────────────────────────
# Leave blank to use the built-in SQLite fallback (data/website_builder.db)
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_DATABASE=WEBSITE_BUILDER
SNOWFLAKE_SCHEMA=PUBLIC
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_ROLE=SYSADMIN

# ── Auth / JWT ────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-secret
JWT_TTL_MINUTES=1440

# ── Stripe (platform billing) ─────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_ENTERPRISE_PRICE_ID=

# ── OTP – Email (SMTP / SendGrid) ─────────────────────
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=
SMTP_FROM=noreply@websitebuilder.ai

# ── OTP – SMS (Twilio) ────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ── CORS ──────────────────────────────────────────────
# Comma-separated allowed origins. Leave blank = localhost only.
# Example: https://app.yourdomain.com,https://admin.yourdomain.com
CORS_ORIGINS=

# ── Web Search (Tavily) ───────────────────────────────
TAVILY_API_KEY=

# ── Social Search (RapidAPI Twitter) ─────────────────
RAPIDAPI_KEY=

# ── App ───────────────────────────────────────────────
OUTPUT_DIR=output
# Optional: override SQLite DB path (default: data/website_builder.db)
SQLITE_DB_PATH=data/website_builder.db
WEBSITE_DOMAIN=
VERBOSE_MODE=true

